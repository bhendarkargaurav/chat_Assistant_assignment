# Application
APP_NAME=Lenny Growth Assistant
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://lenny:lenny@localhost:5432/lenny_assistant

# LLM provider: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama (mandatory local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Cloud LLM (set one when switching provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_MAX_TOKENS=4096

# RAG
EMBEDDING_DIMENSION=768
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_ESSAY_TOP_K=8

# Agent routing
ROUTER_MODE=hybrid
ROUTER_CONFIDENCE_THRESHOLD=0.45
CONVERSATION_HISTORY_LIMIT=10

# Ship 30 for 30 essays
ESSAY_TARGET_WORDS=1250
ESSAY_WORD_TOLERANCE=0.12
ESSAY_MAX_EXPANSIONS=1

# Artifacts
ARTIFACT_MAX_BYTES=1000000

# Resilience
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=3
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5

# Observability: text | json
LOG_FORMAT=text
